# Desarrollo local: este ID corresponde a la clave PUBLICA del manifest.
CHROME_EXTENSION_IDS=fjjgjakbpjhhegekcjogilmfheaicjge
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
DATABASE_PATH=.runtime/assistant.sqlite3
ENABLE_DEMO=true

# Cliente OAuth web, configurado solo en el backend. Nunca subir el secreto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA opcional. Sin estos valores el simulador usa SymPy sin llamadas externas.
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=

# Copiloto local (sin clave): cambia AI_PROVIDER a ollama y AI_MODEL al modelo
# instalado, por ejemplo gemma3:4b. Ollama escucha en 127.0.0.1:11434.
AI_TIMEOUT_SECONDS=120
