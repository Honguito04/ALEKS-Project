# Desarrollo: copia a .env sin sobrescribir configuraciones existentes.
WEB_PUBLIC_MODE=false
WEB_PUBLIC_URL=http://127.0.0.1:8000
# Local: vacío usa SQLite de desarrollo. Producción requiere PostgreSQL con TLS.
WEB_DATABASE_URL=
GEMINI_API_KEY=
# Elegir un modelo que AI Studio muestre disponible en Free para tu proyecto.
# No activar facturación. No se presupone disponibilidad ni cuota fija.
GEMINI_MODEL=
WEB_ACCOUNT_DAILY_CALLS=10
WEB_GLOBAL_DAILY_CALLS=100
WEB_AI_TIMEOUT_SECONDS=60
