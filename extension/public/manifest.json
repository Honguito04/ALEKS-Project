{
  "manifest_version": 3,
  "name": "Aleks Project",
  "version": "0.6.1",
  "description": "Conecta la web de Aleks Project con la pestaña ALEKS que autorices.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "activeTab",
    "debugger",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://latam.aleks.com/*",
    "https://latam-awu.aleks.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/aleks-16.png",
    "32": "icons/aleks-32.png",
    "48": "icons/aleks-48.png",
    "128": "icons/aleks-128.png"
  },
  "action": {
    "default_title": "Abrir Aleks Project",
    "default_icon": {
      "16": "icons/aleks-16.png",
      "32": "icons/aleks-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "key": ""
}
