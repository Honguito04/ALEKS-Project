{
  "manifest_version": 3,
  "name": "Asistente Matem\u00e1tico \u2014 MVP",
  "version": "0.2.0",
  "description": "Asistente local con recorrido ALEKS: escribe enteros y avanza tras confirmar Correcta.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "activeTab",
    "identity"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://latam.aleks.com/*",
    "https://latam-awu.aleks.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir asistente matem\u00e1tico"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8000"
  },
  "key": ""
}
